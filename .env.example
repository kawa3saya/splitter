# Copy to .env.local and fill in. .env.local is git-ignored.

# Supabase ------------------------------------------------------------------
# Project URL. Supabase dashboard > Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Service role key. RLS is enabled with no policies, so every query goes
# through this key from server actions / server components only.
# SECRET - never expose it to the client and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Site ----------------------------------------------------------------------
# Canonical origin for metadata, robots.txt, sitemap.xml, JSON-LD and the
# shareable trip link. Optional: defaults to the production Workers URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
