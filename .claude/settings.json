{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env.local)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Bash(cat .env.local)",
      "Bash(cat ./.env.local)",
      "Bash(head .env.local)",
      "Bash(tail .env.local)",
      "Bash(less .env.local)",
      "Bash(more .env.local)",
      "Bash(source .env.local)",
      "Bash(. .env.local)",
      "Bash(*.env.local*)"
    ]
  }
}
