{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx opennextjs-cloudflare deploy*)",
      "Bash(npx supabase db reset*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npx supabase:*)",
      "Edit(./supabase/migrations/**)",
      "Write(./supabase/migrations/**)",
      "Edit(./.gitignore)",
      "Write(./.gitignore)"
    ],
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "objects.githubusercontent.com",
        "github.com",
        "api.github.com",
        "*.supabase.co",
        "api.frankfurter.dev"
      ],
      "deniedDomains": [
        "*:22"
      ],
      "allowLocalBinding": true
    },
    "credentials": {
      "files": [
        {
          "path": ".env.local",
          "mode": "deny"
        },
        {
          "path": ".dev.vars",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
